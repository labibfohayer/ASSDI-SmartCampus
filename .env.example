# ==========================================
# ASSDI Environment Variables (Template)
# Never commit real secrets to source control.
# ==========================================

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-change-this-in-production-assdi-demo-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL - supports single DATABASE_URL in prod or discrete vars)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_ENGINE=django.db.backends.postgresql
DB_NAME=assdi_db
DB_USER=assdi_user
DB_PASSWORD=assdi_secure_password_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SimpleJWT Security
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Throttling / Rate Limits
THROTTLE_LOGIN_IP_RATE=100/minute
THROTTLE_LOGIN_ACCOUNT_FAILED_LIMIT=5
THROTTLE_LOGIN_ACCOUNT_LOCK_MINUTES=5
